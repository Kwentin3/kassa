// 1C HTML Shell Diagnostic Loader
// Object module draft for an external data processor (.epf).
//
// Назначение:
//   Хранить безопасные defaults и короткое описание обработки.
//
// Важно:
//   Это исходник для ручной сборки внешней обработки в 1С Designer/EDT.
//   В текущем репозитории бинарный .epf не собирался и не тестировался в 1С.
//
// Безопасность:
//   Здесь нет обращений к РМК, чеку, оплате, ККТ, фискализации или маркировке.

#Область Public

Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Наименование", "1C HTML Shell Diagnostic Loader");
	ПараметрыРегистрации.Вставить("Версия", "0.1");
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь);
	ПараметрыРегистрации.Вставить("Информация", ОписаниеНазначения());

	Возврат ПараметрыРегистрации;

КонецФункции

Функция ОписаниеНазначения() Экспорт

	Возврат
		"Минимальный диагностический loader для проверки обмена HTML ↔ 1С. "
		+ "Работает только с командами diag.*. "
		+ "Не обращается к РМК, чеку, оплате, ККТ, фискализации или маркировке.";

КонецФункции

Функция ДиагностическийURLПоУмолчанию() Экспорт

	Возврат "https://kassa.speechbattle.com/diagnostics/1c-html-shell";

КонецФункции

Функция ВерсияДиагностическогоПротокола() Экспорт

	Возврат "0.1";

КонецФункции

#КонецОбласти
