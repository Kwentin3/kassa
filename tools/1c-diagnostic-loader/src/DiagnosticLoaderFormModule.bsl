КонецПроцедуры

&НаКлиенте
Процедура ПолеHTMLДокументаПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	ОбработатьСобытиеHTMLПоля("click", ДанныеСобытия, СтандартнаяОбработка);

КонецПроцедуры

&НаКлиенте
Процедура ПолеHTMLДокументаПриПереходе(Элемент, ДанныеСобытия, СтандартнаяОбработка)

	ОбработатьСобытиеHTMLПоля("navigation", ДанныеСобытия, СтандартнаяОбработка);

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьСобытиеHTMLПоля(ИмяСобытия, ДанныеСобытия, СтандартнаяОбработка)

	КомандаJSON = "";
	Транспорт = "unknown";
	Href = ПолучитьHrefИзДанныхСобытия(ДанныеСобытия);

	Если Не ПустаяСтрока(Href) И СтрНачинаетсяС(Href, "oneshell://diag") Тогда
		КомандаJSON = ИзвлечьPayloadИзHref(Href);
		Транспорт = "href";
		СтандартнаяОбработка = Ложь;
	Иначе
		КомандаJSON = ПрочитатьКомандуИзDOMMailbox();
		Если Не ПустаяСтрока(КомандаJSON) Тогда
			Транспорт = "domMailbox";
			СтандартнаяОбработка = Ложь;
		КонецЕсли;
	КонецЕсли;

	Если ПустаяСтрока(КомандаJSON) Тогда
		Возврат;
	КонецЕсли;

	ПоследняяКомандаJSON = КомандаJSON;
	ЗаписатьЖурнал("html.command.received", Транспорт, "", "received", Лев(КомандаJSON, 300));
	ОбработатьJSONКоманду(КомандаJSON, Транспорт);

КонецПроцедуры

#КонецОбласти

#Область CommandProcessing

&НаКлиенте
Процедура ОбработатьJSONКоманду(КомандаJSON, Транспорт)

	Команда = Неопределено;

	Попытка
		Команда = ПрочитатьJSONБезопасно(КомандаJSON);
	Исключение
		Ответ = СформироватьОтвет("", Ложь, "diag.invalidJson", Транспорт, Новый Структура("code,message", "invalid_json", ОписаниеОшибки()));
		ОтправитьОтветВHTML(Ответ);
		ЗаписатьЖурнал("html.command.parse", Транспорт, "", "invalid_json", ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	ОбработатьДиагностическуюКоманду(Команда, Транспорт);

КонецПроцедуры

&НаКлиенте
Процедура ОбработатьДиагностическуюКоманду(Команда, Транспорт)

	ИмяКоманды = "";
	RequestId = "";
	Payload = Неопределено;

	Если Команда = Неопределено Тогда
		Ответ = СформироватьОтвет("", Ложь, "diag.invalidCommand", Транспорт, Новый Структура("code,message", "invalid_command", "Command is undefined"));
		ОтправитьОтветВHTML(Ответ);
		Возврат;
	КонецЕсли;

	ИмяКоманды = ПолучитьПолеJSON(Команда, "command", "");
	RequestId = ПолучитьПолеJSON(Команда, "requestId", "");
	Payload = ПолучитьПолеJSON(Команда, "payload", Неопределено);

	Если ПустаяСтрока(RequestId) Тогда
		RequestId = "missing-request-id-" + СформироватьКороткийИдентификатор();
	КонецЕсли;

	Если ПустаяСтрока(ИмяКоманды) Тогда
		Ответ = СформироватьОтвет(RequestId, Ложь, "diag.invalidCommand", Транспорт, Новый Структура("code,message", "unknown_command", "Command name is empty"));
		ОтправитьОтветВHTML(Ответ);
		ЗаписатьЖурнал("diag.command", Транспорт, RequestId, "failed", "Empty command");
		Возврат;
	КонецЕсли;

	Если Не СтрНачинаетсяС(ИмяКоманды, "diag.") Тогда
		// Safety boundary: do not execute production bridge commands here.
		Ответ = СформироватьОтвет(RequestId, Ложь, ИмяКоманды, Транспорт, Новый Структура("code,message", "forbidden_command", "Only diag.* commands are allowed"));
		ОтправитьОтветВHTML(Ответ);
		ЗаписатьЖурнал("diag.command", Транспорт, RequestId, "forbidden", ИмяКоманды);
		Возврат;
	КонецЕсли;

	Если ИмяКоманды = "diag.ready" Тогда
		ОтветPayload = Новый Структура("ready,transport,environment", Истина, Транспорт, Метаданные1С());
	ИначеЕсли ИмяКоманды = "diag.ping" Тогда
		ОтветPayload = Новый Структура("echo,transport", Истина, Транспорт);
	ИначеЕсли ИмяКоманды = "diag.hrefTransport" Тогда
		ОтветPayload = Новый Структура("transport", "href");
	ИначеЕсли ИмяКоманды = "diag.domMailbox" Тогда
		ОтветPayload = Новый Структура("transport", "domMailbox");
	ИначеЕсли ИмяКоманды = "diag.directJsCall" Тогда
		ОтветPayload = Новый Структура("directJsCallAttempted", Истина);
	ИначеЕсли ИмяКоманды = "diag.payloadSize" Тогда
		ОтветPayload = Новый Структура("payloadAccepted,transport", Истина, Транспорт);
	ИначеЕсли ИмяКоманды = "diag.roundTrip" Тогда
		ОтветPayload = Новый Структура("serverTimestamp,transport", ТекущаяДатаISO(), Транспорт);
	ИначеЕсли ИмяКоманды = "diag.getEnvironmentFrom1C" Тогда
		ОтветPayload = Метаданные1С();
	Иначе
		Ответ = СформироватьОтвет(RequestId, Ложь, ИмяКоманды, Транспорт, Новый Структура("code,message", "unknown_command", "Unknown diag command"));
		ОтправитьОтветВHTML(Ответ);
		ЗаписатьЖурнал("diag.command", Транспорт, RequestId, "unknown_command", ИмяКоманды);
		Возврат;
	КонецЕсли;

	Ответ = СформироватьОтвет(RequestId, Истина, ИмяКоманды, Транспорт, ОтветPayload);
	ОтправитьОтветВHTML(Ответ);
	ЗаписатьЖурнал("diag.command", Транспорт, RequestId, "ok", ИмяКоманды);

КонецПроцедуры

&НаКлиенте
Функция СформироватьОтвет(RequestId, OK, ИмяКоманды, Транспорт, Payload)

	Ответ = Новый Структура;
	Ответ.Вставить("diagnosticVersion", DiagnosticVersion());
	Ответ.Вставить("requestId", RequestId);
	Ответ.Вставить("ok", OK);
	Ответ.Вставить("source", LoaderSource());
	Ответ.Вставить("command", ИмяКоманды);
	Ответ.Вставить("transport", Транспорт);
	Ответ.Вставить("payload", Payload);
	Ответ.Вставить("timestamp", ТекущаяДатаISO());

	Возврат Ответ;

КонецФункции

&НаКлиенте
Функция ПолучитьПолеJSON(ОбъектJSON, ИмяПоля, ЗначениеПоУмолчанию)

	ЗначениеПоля = ЗначениеПоУмолчанию;

	Если ОбъектJSON = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Попытка
		Если ОбъектJSON.Свойство(ИмяПоля, ЗначениеПоля) Тогда
			Возврат ЗначениеПоля;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		Возврат ОбъектJSON[ИмяПоля];
	Исключение
		Возврат ЗначениеПоУмолчанию;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область HtmlResponse

&НаКлиенте
Процедура ОтправитьОтветВHTML(Ответ)

	ПоследнийОтветJSON = СериализоватьJSONБезопасно(Ответ);

	Если ПопытатьсяВызватьJS("receiveBridgeAck", Ответ) Тогда
		ЗаписатьЖурнал("html.response", "directJsCall", Ответ.requestId, "ok", "Object passed to receiveBridgeAck");
		Возврат;
	КонецЕсли;

	Если ПопытатьсяВызватьJS("receiveBridgeAck", ПоследнийОтветJSON) Тогда
		ЗаписатьЖурнал("html.response", "directJsCall", Ответ.requestId, "partial", "JSON string passed to receiveBridgeAck");
		Возврат;
	КонецЕсли;

	Если ЗаписатьОтветВДOMMailbox(ПоследнийОтветJSON) Тогда
		ЗаписатьЖурнал("html.response", "domMailbox", Ответ.requestId, "partial", "Response written to DOM mailbox");
		Возврат;
	КонецЕсли;

	ЗаписатьЖурнал("html.response", "none", Ответ.requestId, "failed", "Cannot send response to HTML");

КонецПроцедуры

&НаКлиенте
Функция ПопытатьсяВызватьJS(ИмяМетода, Значение)

	ОкноHTML = ПолучитьКонтекстОкнаHTML();
	Если ОкноHTML = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Harness = ОкноHTML.DiagnosticHarness;
		Если Harness = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;

		Если ИмяМетода = "receiveBridgeAck" Тогда
			Harness.receiveBridgeAck(Значение);
		ИначеЕсли ИмяМетода = "receiveFrom1C" Тогда
			Harness.receiveFrom1C(Значение);
		ИначеЕсли ИмяМетода = "receiveStateFrom1C" Тогда
			Harness.receiveStateFrom1C(Значение);
		Иначе
			Возврат Ложь;
		КонецЕсли;

		Возврат Истина;
	Исключение
		ЗаписатьЖурнал("html.direct_js", "directJsCall", "", "failed", ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;

КонецФункции

&НаКлиенте
Функция ЗаписатьОтветВДOMMailbox(JSONОтвет)

	ДокументHTML = ПолучитьHTMLДокумент();
	Если ДокументHTML = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Узел = ДокументHTML.getElementById("diagnostic-response-mailbox");
		Если Узел = Неопределено Тогда
			Узел = ДокументHTML.createElement("textarea");
			Узел.id = "diagnostic-response-mailbox";
			Узел.style.display = "none";
			ДокументHTML.body.appendChild(Узел);
		КонецЕсли;

		Узел.value = JSONОтвет;
		Узел.setAttribute("data-updated-at", ТекущаяДатаISO());
		Возврат Истина;
	Исключение
		ЗаписатьЖурнал("html.dom_mailbox_write", "domMailbox", "", "failed", ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;

КонецФункции

#КонецОбласти

#Область HtmlDomHelpers

&НаКлиенте
Функция ПолучитьHTMLДокумент()

	Попытка
		Возврат Элементы.ПолеHTMLДокумента.Документ;
	Исключение
		ЗаписатьЖурнал("html.document", "dom", "", "failed", ОписаниеОшибки());
		Возврат Неопределено;
	КонецПопытки;

КонецФункции

&НаКлиенте
Функция ПолучитьКонтекстОкнаHTML()

	ДокументHTML = ПолучитьHTMLДокумент();
	Если ДокументHTML = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Если ДокументHTML.defaultView <> Неопределено Тогда
			Возврат ДокументHTML.defaultView;
		КонецЕсли;
	Исключение
	КонецПопытки;

	// parentWindow упоминается в старых практических примерах, но в новых WebKit
	// режимах может быть недоступен. Оставлено только как compatibility fallback.
	Попытка
		Если ДокументHTML.parentWindow <> Неопределено Тогда
			Возврат ДокументHTML.parentWindow;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Возврат Неопределено;

КонецФункции

&НаКлиенте
Функция ПолучитьHrefИзДанныхСобытия(ДанныеСобытия)

	Результат = "";

	Если ДанныеСобытия = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Попытка
		Если ДанныеСобытия.Свойство("href", Результат) Тогда
			Возврат Результат;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		Если ДанныеСобытия.Свойство("HRef", Результат) Тогда
			Возврат Результат;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Попытка
		Результат = ДанныеСобытия.href;
		Возврат Результат;
	Исключение
	КонецПопытки;

	Попытка
		Результат = ДанныеСобытия.HRef;
		Возврат Результат;
	Исключение
	КонецПопытки;

	Возврат "";

КонецФункции

