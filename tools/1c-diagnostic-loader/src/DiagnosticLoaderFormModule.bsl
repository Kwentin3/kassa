&НаКлиенте
Функция ЕслиПусто(Значение, ЗначениеПоУмолчанию)

	Если Значение = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Если ПустаяСтрока(Строка(Значение)) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;

	Возврат Значение;

КонецФункции

&НаКлиенте
Процедура ЗаписатьЖурнал(Событие, Транспорт, RequestId, Результат, Детали)

	СтрокаЖурнала = ТекущаяДатаISO()
		+ " | event=" + Строка(Событие)
		+ " | transport=" + Строка(Транспорт)
		+ " | requestId=" + Строка(RequestId)
		+ " | result=" + Строка(Результат)
		+ " | " + Строка(Детали);

	Если ПустаяСтрока(ЖурналСобытий) Тогда
		ЖурналСобытий = СтрокаЖурнала;
	Иначе
		ЖурналСобытий = ЖурналСобытий + Символы.ПС + СтрокаЖурнала;
	КонецЕсли;

КонецПроцедуры

