// 1C HTML Shell Diagnostic Loader
// Managed form module draft for Slice 2.
//
// Предпочтительное использование:
//   Создать внешнюю обработку, добавить управляемую форму, реквизиты и элементы
//   из src/form-structure.md, затем вставить этот код в модуль формы.
//
// Статус:
//   Draft для 1С-специалиста. Требует проверки на целевой версии платформы,
//   типе клиента и режиме совместимости.
//
// Безопасность:
//   Этот модуль намеренно обрабатывает только diag.* команды.
//   Он не должен вызывать РМК, менять чек, запускать оплату, ККТ,
//   фискализацию, маркировку или любые production bridge commands.
//
// TODO: проверить href/navigation transport на целевой версии 1С.
// TODO: проверить DOM mailbox transport на целевой версии 1С.
// TODO: проверить direct JS call на целевой версии 1С.
// TODO: проверить толстый/тонкий/web-клиент отдельно.
// TODO: не смешивать diag.* с production bridge commands.

#Область Constants

&НаКлиенте
Функция DiagnosticVersion()
	Возврат "0.1";
КонецФункции

&НаКлиенте
Функция LoaderSource()
	Возврат "1c-diagnostic-loader";
КонецФункции

&НаКлиенте
Функция DefaultDiagnosticUrl()
	Возврат "https://kassa.speechbattle.com/diagnostics/1c-html-shell";
КонецФункции

#КонецОбласти

#Область FormLifecycle

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Если ПустаяСтрока(ДиагностическийURL) Тогда
		ДиагностическийURL = DefaultDiagnosticUrl();
	КонецЕсли;

	Если ПустаяСтрока(RunId) Тогда
		RunId = СформироватьRunId();
	КонецЕсли;

	Если ПустаяСтрока(TerminalLabel) Тогда
		TerminalLabel = "manual-terminal";
	КонецЕсли;

	Если ПустаяСтрока(ТипКлиента) Тогда
		ТипКлиента = "unknown";
	КонецЕсли;

	Если ПустаяСтрока(ИмяКонфигурации) Тогда
		ИмяКонфигурации = "unknown";
	КонецЕсли;

	Если ПустаяСтрока(ВерсияКонфигурации) Тогда
		ВерсияКонфигурации = "";
	КонецЕсли;

	Если ПустаяСтрока(РежимСовместимости) Тогда
		РежимСовместимости = "";
	КонецЕсли;

	Если ПустаяСтрока(ВерсияПлатформы) Тогда
		ВерсияПлатформы = ПолучитьВерсиюПлатформыБезопасно();
	КонецЕсли;

	ЗаписатьЖурнал("form.open", "", "", "ready", "Diagnostic Loader form opened");

КонецПроцедуры

#КонецОбласти

#Область Commands

&НаКлиенте
Процедура ОткрытьДиагностику(Команда)

	HTMLАдрес = СформироватьURLДиагностики();
	ЗаписатьЖурнал("html.open", "url", "", "ok", HTMLАдрес);

КонецПроцедуры

&НаКлиенте
Процедура ПередатьСведенияО1С(Команда)

	Ответ = СформироватьОтвет("manual-environment-" + СформироватьКороткийИдентификатор(), Истина, "diag.getEnvironmentFrom1C", "manual", Метаданные1С());
	ПоследнийОтветJSON = СериализоватьJSONБезопасно(Ответ);

	Если ПопытатьсяВызватьJS("receiveStateFrom1C", Метаданные1С()) Тогда
		ЗаписатьЖурнал("1c.metadata", "directJsCall", Ответ.requestId, "ok", "Metadata sent via receiveStateFrom1C");
	ИначеЕсли ПопытатьсяВызватьJS("receiveBridgeAck", ПоследнийОтветJSON) Тогда
		ЗаписатьЖурнал("1c.metadata", "directJsCall", Ответ.requestId, "partial", "Metadata ack sent as JSON string");
	ИначеЕсли ЗаписатьОтветВДOMMailbox(ПоследнийОтветJSON) Тогда
		ЗаписатьЖурнал("1c.metadata", "domMailbox", Ответ.requestId, "partial", "Metadata written to DOM mailbox");
	Иначе
		ЗаписатьЖурнал("1c.metadata", "none", Ответ.requestId, "failed", "Cannot send metadata to HTML");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьDiagPing(Команда)

	// Эта кнопка проверяет направление 1С -> HTML через receiveBridgeAck.
	// Полноценный HTML -> 1С -> HTML ping должен прийти из HTML через событие HTML-поля.
	КомандаДиагностики = Новый Структура;
	КомандаДиагностики.Вставить("diagnosticVersion", DiagnosticVersion());
	КомандаДиагностики.Вставить("requestId", "manual-ping-" + СформироватьКороткийИдентификатор());
	КомандаДиагностики.Вставить("command", "diag.ping");
	КомандаДиагностики.Вставить("payload", Новый Структура);
	КомандаДиагностики.Вставить("timestamp", ТекущаяДатаISO());

	ОбработатьДиагностическуюКоманду(КомандаДиагностики, "manualButton");

КонецПроцедуры

&НаКлиенте
Процедура УстановитьHTMLHooks(Команда)

	// Version-dependent helper. Он добавляет в DOM тестовую ссылку и mailbox,
	// если текущая диагностическая страница еще не содержит активные Slice 2 hooks.
	// TODO: проверить этот прием на целевой версии 1С.
	ДокументHTML = ПолучитьHTMLДокумент();
	Если ДокументHTML = Неопределено Тогда
		ЗаписатьЖурнал("html.hooks", "dom", "", "failed", "HTML document is not available");
		Возврат;
	КонецЕсли;

	Попытка
		Body = ДокументHTML.body;
		Если Body = Неопределено Тогда
			ЗаписатьЖурнал("html.hooks", "dom", "", "failed", "HTML body is not available");
			Возврат;
		КонецЕсли;

		КомандаPing = Новый Структура;
		КомандаPing.Вставить("diagnosticVersion", DiagnosticVersion());
		КомандаPing.Вставить("requestId", "href-ping-" + СформироватьКороткийИдентификатор());
		КомандаPing.Вставить("command", "diag.hrefTransport");
		КомандаPing.Вставить("payload", Новый Структура("transport", "href"));
		КомандаPing.Вставить("timestamp", ТекущаяДатаISO());

		JSONКоманды = СериализоватьJSONБезопасно(КомандаPing);
		Ссылка = ДокументHTML.createElement("a");
		Ссылка.id = "diagnostic-1c-href-test";
		Ссылка.href = "oneshell://diag?payload=" + КодироватьДляURL(JSONКоманды);
		Ссылка.innerText = "Проверить обмен HTML → 1С через href";
		Ссылка.style.display = "inline-block";
		Ссылка.style.margin = "8px";
		Ссылка.style.padding = "12px 16px";
		Ссылка.style.border = "1px solid #1b7f5f";
		Ссылка.style.background = "#e9f7f1";
		Ссылка.style.color = "#12382b";
		Body.appendChild(Ссылка);

		Если ДокументHTML.getElementById("diagnostic-command-mailbox") = Неопределено Тогда
			Mailbox = ДокументHTML.createElement("textarea");
			Mailbox.id = "diagnostic-command-mailbox";
			Mailbox.style.display = "none";
			Body.appendChild(Mailbox);
		КонецЕсли;

		Если ДокументHTML.getElementById("diagnostic-command-trigger") = Неопределено Тогда
			Trigger = ДокументHTML.createElement("button");
			Trigger.id = "diagnostic-command-trigger";
			Trigger.innerText = "diagnostic-command-trigger";
			Trigger.style.display = "none";
			Body.appendChild(Trigger);
		КонецЕсли;

		ЗаписатьЖурнал("html.hooks", "dom", КомандаPing.requestId, "ok", "Diagnostic href link and mailbox nodes created");
	Исключение
		ЗаписатьЖурнал("html.hooks", "dom", "", "failed", ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура СкопироватьЖурнал(Команда)

	// В разных версиях платформы доступ к clipboard отличается.
	// Поэтому baseline - видимый многострочный журнал на форме.
	ЗаписатьЖурнал("log.copy", "manual", "", "not_tested", "Copy manually from form field");

КонецПроцедуры

