Функция Метаданные1С()

	Данные = Новый Структура;
	Данные.Вставить("platformVersion", ЕслиПусто(ВерсияПлатформы, "unknown"));
	Данные.Вставить("clientType", ЕслиПусто(ТипКлиента, "unknown"));
	Данные.Вставить("configurationName", ЕслиПусто(ИмяКонфигурации, "unknown"));
	Данные.Вставить("configurationVersion", ЕслиПусто(ВерсияКонфигурации, ""));
	Данные.Вставить("compatibilityMode", ЕслиПусто(РежимСовместимости, ""));
	Данные.Вставить("terminalLabel", ЕслиПусто(TerminalLabel, ""));

	Возврат Данные;

