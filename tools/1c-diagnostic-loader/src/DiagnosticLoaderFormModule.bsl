#КонецОбласти

#Область UrlAndJson

&НаКлиенте
Функция СформироватьURLДиагностики()

	БазовыйURL = ДиагностическийURL;
	Если ПустаяСтрока(БазовыйURL) Тогда
		БазовыйURL = DefaultDiagnosticUrl();
	КонецЕсли;

	Разделитель = "?";
	Если СтрНайти(БазовыйURL, "?") > 0 Тогда
		Разделитель = "&";
	КонецЕсли;

	Возврат БазовыйURL
		+ Разделитель
		+ "runId=" + КодироватьДляURL(RunId)
		+ "&terminalLabel=" + КодироватьДляURL(TerminalLabel)
		+ "&verdictScope=one_c_html_field_unconnected";

КонецФункции

&НаКлиенте
Функция ИзвлечьPayloadИзHref(Href)

	Позиция = СтрНайти(Href, "payload=");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;

	Payload = Сред(Href, Позиция + СтрДлина("payload="));
	Амперсанд = СтрНайти(Payload, "&");
	Если Амперсанд > 0 Тогда
		Payload = Лев(Payload, Амперсанд - 1);
	КонецЕсли;

	Возврат ДекодироватьURLБезопасно(Payload);

КонецФункции

&НаКлиенте
Функция КодироватьДляURL(Значение)

	СтрокаЗначения = Строка(Значение);
	Попытка
		Возврат КодироватьСтроку(СтрокаЗначения, СпособКодированияСтроки.КодировкаURL);
	Исключение
		// Conservative fallback for common JSON characters.
		Результат = СтрЗаменить(СтрокаЗначения, "%", "%25");
		Результат = СтрЗаменить(Результат, " ", "%20");
		Результат = СтрЗаменить(Результат, """", "%22");
		Результат = СтрЗаменить(Результат, "{", "%7B");
		Результат = СтрЗаменить(Результат, "}", "%7D");
		Результат = СтрЗаменить(Результат, ":", "%3A");
		Результат = СтрЗаменить(Результат, ",", "%2C");
		Результат = СтрЗаменить(Результат, "/", "%2F");
		Возврат Результат;
	КонецПопытки;

КонецФункции

&НаКлиенте
Функция ДекодироватьURLБезопасно(Значение)

	СтрокаЗначения = Строка(Значение);
	Попытка
		Возврат ДекодироватьСтроку(СтрокаЗначения, СпособКодированияСтроки.КодировкаURL);
	Исключение
		Результат = СтрЗаменить(СтрокаЗначения, "%7B", "{");
		Результат = СтрЗаменить(Результат, "%7D", "}");
		Результат = СтрЗаменить(Результат, "%22", """");
		Результат = СтрЗаменить(Результат, "%3A", ":");
		Результат = СтрЗаменить(Результат, "%2C", ",");
		Результат = СтрЗаменить(Результат, "%20", " ");
		Результат = СтрЗаменить(Результат, "%2F", "/");
		Результат = СтрЗаменить(Результат, "%25", "%");
		Возврат Результат;
	КонецПопытки;

КонецФункции

