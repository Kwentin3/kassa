# Dependencies / builds
node_modules/
dist/
dist-1c/
build/
.vite/
coverage/

# .NET build outputs
**/bin/
**/obj/

# Local generated release/smoke artifacts. Publish release zips via GitHub Releases,
# not by committing generated output into the repository.
artifacts/

# Local environment files.
# Keep example schemas tracked, ignore real values.
.env
.env.*
!.env.example
!.env.*.example

# Local deployment overrides
docker-compose.override.yml
.deploy/

# Local documentation exchange buffer; canonical docs live under docs/*, not docs/out.
docs/out/

# Secret material and private keys
.secrets/
ops/secrets/*
!ops/secrets/.gitkeep
*.pem
*.key
id_rsa*
id_ed25519*

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
