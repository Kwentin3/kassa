# Deployment/runbook variables.
# This file is a schema only. Copy to .env.deploy locally and fill real values there.
# .env.deploy is ignored by git.

HOST_DOMAIN=kassa.speechbattle.com
HTTPS_ENABLED=true
STATIC_BUILD_DIR=dist
DEPLOY_TARGET_PATH=/opt/stacks/kassa-web

# SSH/deploy target. Do not commit private keys.
DEPLOY_HOST=192.168.7.64
DEPLOY_USER=roman
DEPLOY_PORT=22

# Existing Traefik settings must be checked on the server before deployment.
TRAEFIK_NETWORK=traefik-net
TRAEFIK_CERT_RESOLVER=letsencrypt
TRAEFIK_ENTRYPOINT=websecure
